# Dedicated server configuration. Do not use a reader's/client's API Key.
# Fill the credentials on the server, outside chat. Keep this file mode 0600.
ZXAI_NEWS_EDITOR_ENABLED=0
ZXAI_NEWS_EDITOR_BASE_URL=
ZXAI_NEWS_EDITOR_MODEL=
ZXAI_NEWS_EDITOR_API_KEY=
ZXAI_NEWS_EDITOR_PER_ROUND=4
ZXAI_NEWS_EDITOR_PER_HOUR=12
ZXAI_NEWS_EDITOR_PER_DAY=96
# Use max_completion_tokens for services/models that require that parameter.
ZXAI_NEWS_EDITOR_TOKEN_FIELD=max_tokens
# Set 0 only for a service without JSON mode; local JSON validation still applies.
ZXAI_NEWS_EDITOR_JSON_MODE=1
# After resolving 401/402/403, change RESUME and restart the news service.
# Same failed article is otherwise not automatically retried.
ZXAI_NEWS_EDITOR_RESUME=
