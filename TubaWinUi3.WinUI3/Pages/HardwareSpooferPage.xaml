<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.HardwareSpooferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TubaWinUi3.Controls"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="EditorHeroBrush" Color="#F0F4FF" />
                <SolidColorBrush x:Key="EditorAccentBrush" Color="#4564D8" />
                <SolidColorBrush x:Key="EditorTileHoverBrush" Color="#F4F6FC" />
                <SolidColorBrush x:Key="EditorIconBrush" Color="#E7EDFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="EditorHeroBrush" Color="#232D43" />
                <SolidColorBrush x:Key="EditorAccentBrush" Color="#A9BFFF" />
                <SolidColorBrush x:Key="EditorTileHoverBrush" Color="#303747" />
                <SolidColorBrush x:Key="EditorIconBrush" Color="#303C58" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="EditorHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="EditorAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="EditorTileHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="EditorIconBrush" Color="{ThemeResource SystemColorWindowColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="EditorPrimaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="EditorSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="EditorIconPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EditorIconBrush}" />
        </Style>
        <Style x:Key="EditorIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource EditorAccentBrush}" />
        </Style>
        <Style x:Key="HardwareCategoryTileStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="142" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{ThemeResource EditorTileHoverBrush}" />
                                            <Setter Target="Chrome.BorderBrush" Value="{ThemeResource EditorAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.85" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.55" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectedHardwareCategoryTileStyle" TargetType="Button" BasedOn="{StaticResource HardwareCategoryTileStyle}">
            <Setter Property="Background" Value="{ThemeResource EditorHeroBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EditorAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:ToolPageHeader x:Name="PageHeader" Title="配置修改器"
            Subtitle="六类硬件型号 · 修改前预览 · 原始名称可恢复" Glyph="&#xEEA1;" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Padding="24,0,24,16">
            <StackPanel Spacing="14" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Border Padding="20" CornerRadius="12" Background="{ThemeResource EditorHeroBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WorkspaceTitleText" FontSize="24" FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="WorkspaceHintText" TextWrapping="Wrap" FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CatalogStatusText" FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BackupStatusText" FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="32" Height="32" />
                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
                <Grid x:Name="CategoryCardsPanel" RowSpacing="12" ColumnSpacing="12" SizeChanged="CategoryCardsPanel_SizeChanged" />
                <StackPanel x:Name="EditorsPanel" Spacing="12" />
                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PreviewTitleText" FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <StackPanel x:Name="PreviewPanel" Spacing="8" />
                    </StackPanel>
                </Border>
                <Expander x:Name="ScopeExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="ScopeText" TextWrapping="Wrap" FontSize="12" Margin="8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12,24,16" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10" MaxWidth="1120" HorizontalAlignment="Stretch">
                <CheckBox x:Name="SyncWindowsCheck" IsChecked="True"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ApplyButton" Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="RestoreButton" Grid.Column="1" Click="RestoreButton_Click"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshButton_Click"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DraftStatusText" Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
