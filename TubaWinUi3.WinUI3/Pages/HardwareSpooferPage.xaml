<?xml version="1.0" encoding="utf-8" ?>
<Page xmlns:l="using:WinUI3Localizer"
    x:Class="TubaWinUi3.Pages.HardwareSpooferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolPageHeader
            x:Name="PageHeader"
            Grid.Row="0"
            Title="配置修改器"
            Subtitle="修改注册表中的硬件信息显示" l:Uids.Uid="Hw_PageHeader"
            Glyph="&#xEEA1;" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel x:Name="MainPanel" Spacing="14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="已修改项" l:Uids.Uid="Hw_L31" />
                            <TextBlock x:Name="ModifiedCountText" FontSize="20" FontWeight="Bold" Text="0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="备份状态" l:Uids.Uid="Hw_L37" />
                            <TextBlock x:Name="BackupStatusText" FontSize="14" FontWeight="Bold" Text="无备份" l:Uids.Uid="Hw_BackupStatusText" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="11" Opacity="1.0" Text="管理员权限" l:Uids.Uid="Hw_L43" />
                            <TextBlock x:Name="AdminStatusText" FontSize="14" FontWeight="Bold" Text="检测中..." l:Uids.Uid="Hw_AdminStatusText" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="WarningBorder" Padding="14,10,14,10" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="WarningIcon" FontSize="16" Glyph="&#xE7BA;" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Text="修改注册表可能影响系统稳定性，建议在修改前创建系统还原点。部分软件可能仍通过其他方式检测真实硬件。" l:Uids.Uid="Hw_L52" />
                    </StackPanel>
                </Border>

                <Expander x:Name="CpuExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xEEA1;" />
                            <TextBlock FontWeight="Bold" Text="CPU 处理器" l:Uids.Uid="Hw_L60" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="CPU 名称：" l:Uids.Uid="Hw_L66" />
                            <ComboBox x:Name="CpuNameBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="输入或选择 CPU 名称" l:Uids.Uid="Hw_CpuNameBox" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="厂商标识：" l:Uids.Uid="Hw_L71" />
                            <ComboBox x:Name="CpuVendorBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <x:String>GenuineIntel</x:String>
                                <x:String>AuthenticAMD</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="频率 (MHz)：" l:Uids.Uid="Hw_L79" />
                            <TextBox x:Name="CpuMhzBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="如 3600" l:Uids.Uid="Hw_CpuMhzBox" />
                        </Grid>
                        <TextBlock x:Name="CpuOriginalText" FontSize="11" Opacity="1.0" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander x:Name="GpuExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xF211;" />
                            <TextBlock FontWeight="Bold" Text="GPU 显卡" l:Uids.Uid="Hw_L90" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="GPU 描述：" l:Uids.Uid="Hw_L96" />
                            <ComboBox x:Name="GpuDescBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="输入或选择 GPU 名称" l:Uids.Uid="Hw_GpuDescBox" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="驱动提供商：" l:Uids.Uid="Hw_L101" />
                            <ComboBox x:Name="GpuProviderBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch">
                                <x:String>NVIDIA</x:String>
                                <x:String>AMD</x:String>
                                <x:String>Intel</x:String>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="GpuOriginalText" FontSize="11" Opacity="1.0" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander x:Name="SystemExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE977;" />
                            <TextBlock FontWeight="Bold" Text="系统信息" l:Uids.Uid="Hw_SystemCard" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="产品名称：" l:Uids.Uid="Hw_L122" />
                            <ComboBox x:Name="SystemProductBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="如 XPS 15 9530" l:Uids.Uid="Hw_SystemProductBox" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="制造商：" l:Uids.Uid="Hw_L127" />
                            <ComboBox x:Name="SystemManufacturerBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch">
                                <x:String>Dell Inc.</x:String>
                                <x:String>LENOVO</x:String>
                                <x:String>ASUSTeK COMPUTER INC.</x:String>
                                <x:String>HP</x:String>
                                <x:String>Microsoft Corporation</x:String>
                                <x:String>Apple Inc.</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="系统系列：" l:Uids.Uid="Hw_L139" />
                            <TextBox x:Name="SystemFamilyBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="可选" l:Uids.Uid="Hw_SystemFamilyBox" />
                        </Grid>
                        <TextBlock x:Name="SystemOriginalText" FontSize="11" Opacity="1.0" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander x:Name="BiosExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE977;" />
                            <TextBlock FontWeight="Bold" Text="BIOS / 主板" l:Uids.Uid="Hw_L150" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="BIOS 厂商：" l:Uids.Uid="Hw_L156" />
                            <ComboBox x:Name="BiosVendorBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch">
                                <x:String>American Megatrends Inc.</x:String>
                                <x:String>Insyde Corp.</x:String>
                                <x:String>Phoenix Technologies LTD</x:String>
                                <x:String>Dell Inc.</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="BIOS 版本：" l:Uids.Uid="Hw_L166" />
                            <TextBox x:Name="BiosVersionBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="可选" l:Uids.Uid="Hw_BiosVersionBox" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="主板制造商：" l:Uids.Uid="Hw_L171" />
                            <ComboBox x:Name="BoardManufacturerBox" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch">
                                <x:String>ASUSTeK COMPUTER INC.</x:String>
                                <x:String>Micro-Star International Co., Ltd.</x:String>
                                <x:String>Gigabyte Technology Co., Ltd.</x:String>
                                <x:String>ASRock</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="主板型号：" l:Uids.Uid="Hw_L181" />
                            <TextBox x:Name="BoardProductBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="可选" l:Uids.Uid="Hw_BoardProductBox" />
                        </Grid>
                        <TextBlock x:Name="BiosOriginalText" FontSize="11" Opacity="1.0" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock Text="应用修改" l:Uids.Uid="Hw_L204" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="RestoreButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        <TextBlock Text="一键恢复" l:Uids.Uid="Hw_L210" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="BackupButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE787;" />
                        <TextBlock Text="备份当前" l:Uids.Uid="Hw_L216" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" l:Uids.Uid="HwDetail_Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
