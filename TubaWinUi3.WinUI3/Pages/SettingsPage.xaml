                                                    <TextBlock FontWeight="Bold" Text="AI 提供商" l:Uids.Uid="Settings_AiProvider_Title" />
                                                    <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="内置 DeepSeek 预设，只需填写自己的 API Key（api.deepseek.com 申请）；也可新建自定义提供商" l:Uids.Uid="Settings_Add083" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ComboBox x:Name="AiProviderCombo" MinWidth="230" MaxWidth="340" DisplayMemberPath="Name" SelectionChanged="AiProviderCombo_SelectionChanged" />
