                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE774;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock FontWeight="Bold" Text="API 地址" l:Uids.Uid="Settings_AiEndpoint_Title" />
