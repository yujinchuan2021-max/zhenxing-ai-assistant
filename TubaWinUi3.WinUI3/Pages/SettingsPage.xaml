                                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" Text="硬件" l:Uids.Uid="Settings_Add069" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="1.0" FontSize="13" Text="硬件显示选项与数据源" l:Uids.Uid="Settings_Add070" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
