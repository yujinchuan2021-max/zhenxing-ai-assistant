                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE7C4;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="全局模型" l:Uids.Uid="Settings_AiDefaultModel_Title" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="聊天、Agent 和资讯摘要统一使用；进行中的回复完成后使用新配置" l:Uids.Uid="Settings_AiDefaultModel_Desc" />
                                            </StackPanel>
                                            <ComboBox x:Name="AiDefaultModelCombo" Grid.Column="2" MinWidth="200" MaxWidth="300" DisplayMemberPath="DisplayText" SelectionChanged="AiDefaultModelCombo_SelectionChanged" />
                                        </Grid>



                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsAgentCard" Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontWeight="Bold" Text="枕星目标助手" l:Uids.Uid="Settings_AgentTitle" />
                                        <TextBlock TextWrapping="Wrap" Text="理解目标、准备工具流和接续使用，直接使用上方 AI 接口与模型。" l:Uids.Uid="Settings_AgentShared" />
