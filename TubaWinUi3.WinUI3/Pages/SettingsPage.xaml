                                        </ComboBox>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="执行引擎与默认协作方式用于新对话；已有对话保留原上下文。" l:Uids.Uid="Settings_AgentNewConversation" />
                                        <TextBlock Text="默认协作方式" l:Uids.Uid="Settings_AgentPersona" />
                                        <ComboBox x:Name="AiAgentPersonaCombo" HorizontalAlignment="Stretch" SelectionChanged="AiAgentPersonaCombo_SelectionChanged" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SettingsToolflowUploadCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE753;" />
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"
                                                   Text="上传最终选择的安装工具流" l:Uids.Uid="Settings_Add099" />
