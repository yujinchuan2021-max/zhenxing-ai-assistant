                                                <TextBox x:Name="AiEndpointTextBox" HorizontalAlignment="Stretch" MaxWidth="560" PlaceholderText="https://api.example.com/v1" TextChanged="AiEndpointTextBox_TextChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- API Key（垂直堆叠：输入在上、操作按钮行在下——窄窗不挤压） -->
                                        <Grid Grid.Row="4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE72E;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="Bold" Text="API Key" />
                                                    <TextBlock x:Name="AiApiKeyHintText" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="API 密钥，将安全保存在本地" l:Uids.Uid="Settings_AiApiKey_Hint" />
                                                </StackPanel>
                                                <PasswordBox x:Name="AiApiKeyBox" HorizontalAlignment="Stretch" MaxWidth="560" PlaceholderText="sk-..." PasswordChanged="AiApiKeyBox_PasswordChanged" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="AiKeyLinkButton" Padding="14,6" Click="AiKeyLinkButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE774;" />
                                                            <TextBlock x:Name="AiKeyLinkText" Text="获取 API Key" FontSize="12" l:Uids.Uid="Settings_AiApiKey_GetButton" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="AiTestButton" Padding="14,6" Click="AiTestButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon x:Name="AiTestIcon" FontSize="12" Glyph="&#xE73E;" />
                                                            <TextBlock x:Name="AiTestButtonText" Text="测试连接" FontSize="12" l:Uids.Uid="Settings_AiTest_Button" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 模型列表 -->
                                        <Grid Grid.Row="5" ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE943;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="Bold" Text="模型列表" l:Uids.Uid="Settings_AiModels_Title" />
                                                    <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="预设或自定义模型标识，可在 AI 聊天界面随时切换" l:Uids.Uid="Settings_AiModels_Desc" />
                                                </StackPanel>
                                                <ItemsControl x:Name="AiModelsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="10" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <Button Grid.Column="1" Padding="8,3" Click="AiModelDelete_Click" Tag="{Binding}">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox x:Name="AiNewModelBox" MinWidth="240" PlaceholderText="输入模型标识，如 deepseek-flash" KeyDown="AiNewModelBox_KeyDown" l:Uids.Uid="Settings_Add093" />
                                                    <Button x:Name="AiAddModelButton" Padding="14,6" Click="AiAddModelButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                            <TextBlock Text="添加" FontSize="12" l:Uids.Uid="Settings_AiAddModel_Button" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 默认模型 -->
