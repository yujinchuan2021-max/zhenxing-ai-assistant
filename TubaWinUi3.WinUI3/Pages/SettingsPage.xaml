<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ThirdPartyCreditStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Storyboard x:Name="DrawerOpenStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DrawerOverlayBackground"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="DrawerPanelTransform"
                Storyboard.TargetProperty="X"
                From="420"
                To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="DrawerCloseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="DrawerOverlayBackground"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.15" />
            <DoubleAnimation
                Storyboard.TargetName="DrawerPanelTransform"
                Storyboard.TargetProperty="X"
                From="0"
                To="420"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer
            x:Name="RootScrollViewer"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <RelativePanel HorizontalAlignment="Stretch">
                <StackPanel
                    x:Name="ContentPanel"
                    RelativePanel.AlignHorizontalCenterWithPanel="True"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    MaxWidth="1000"
                    Spacing="4"
                    Padding="40,28,40,48">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        x:Name="SettingsTitleText" Text="设置" l:Uids.Uid="Settings_PageTitle" />
                    <Button x:Name="AllSettingsButton" Content="全部设置" Visibility="Collapsed" HorizontalAlignment="Left" Click="AllSettingsButton_Click" />
                    <TextBlock
                        Opacity="1.0"
                        Margin="0,0,0,16"
                        x:Name="SettingsSubtitleText" TextWrapping="Wrap" Text="管理应用外观、更新及查看关于信息。" l:Uids.Uid="Settings_PageSubtitle" />

                    <Border x:Name="SettingsStoreRatingCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBorderStyle}">
                                <FontIcon FontSize="18" Glyph="&#xE734;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="Bold" Text="喜欢我们的软件吗？" l:Uids.Uid="Settings_StoreRating_Title" />
                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="给一个好评吧！点击直接打开商店评分" l:Uids.Uid="Settings_StoreRating_Desc" />
                            </StackPanel>
                            <Button x:Name="StoreRatingButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Style="{StaticResource AccentButtonStyle}" Click="StoreRatingButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE734;" />
                                    <TextBlock Text="去好评" l:Uids.Uid="Settings_StoreRating_Button" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Expander
                        x:Name="GeneralExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                         IsExpanded="True">
                         <Expander.Header>
                             <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" MinHeight="56">
                                 <Border Style="{StaticResource NavCardIconBorderStyle}">
                                     <FontIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="20" Glyph="&#xE80F;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                 </Border>
                                 <StackPanel VerticalAlignment="Center" Spacing="2">
                                     <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" Text="常规" l:Uids.Uid="Settings_General_Title" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="1.0" FontSize="13" Text="主题、更新、启动页面、快速模式" l:Uids.Uid="Settings_General_Desc" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Content>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="2" Padding="0,4,0,0">

                                <Border x:Name="SettingsUpdateCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE777;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="检查更新" l:Uids.Uid="Settings_ToolsBundle_Button" />
                                            <TextBlock x:Name="UpdateStatusText" Opacity="1.0" FontSize="13" Text="点击检查是否有新版本" l:Uids.Uid="Settings_Update_Status" />
                                        </StackPanel>
                                        <Button x:Name="CheckUpdateButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Click="CheckUpdateButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE777;" />
                                                <TextBlock Text="检查更新" l:Uids.Uid="Settings_ToolsBundle_Button" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsToolsBundleCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE896;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="内核更新" l:Uids.Uid="Settings_ToolsBundle_Title" />
                                            <TextBlock x:Name="ToolsBundleStatusText" Opacity="1.0" FontSize="13" Text="点击检查内核是否有新版本" l:Uids.Uid="Settings_ToolsBundle_Status" />
                                        </StackPanel>
                                        <Button x:Name="CheckToolsBundleButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Click="CheckToolsBundleButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE896;" />
                                                <TextBlock Text="检查更新" l:Uids.Uid="Settings_ToolsBundle_Button" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsNavLayoutCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE713;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="导航布局" l:Uids.Uid="Settings_NavLayout_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="切换侧边栏或顶部标签页导航" l:Uids.Uid="Settings_NavLayout_Desc" />
                                        </StackPanel>
                                        <ComboBox x:Name="NavLayoutComboBox" Grid.Column="2" MinWidth="120" SelectionChanged="NavLayoutComboBox_SelectionChanged" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsFastModeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE945;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="快速模式" l:Uids.Uid="Settings_FastMode_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="禁用所有动画，提升响应速度" l:Uids.Uid="Settings_FastMode_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FastModeToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="FastModeToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsRememberWindowCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE784;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="记住窗口位置和大小" l:Uids.Uid="Settings_RememberWindow_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="关闭后下次启动将居中显示，避免多显示器断开后窗口位置异常" l:Uids.Uid="Settings_RememberWindow_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RememberWindowToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="RememberWindowToggle_Toggled" />
                                    </Grid>
                                </Border>



                            </StackPanel>
                            </ScrollViewer>
                        </Expander.Content>
                    </Expander>

                    <Expander
                        x:Name="AppearanceExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" MinHeight="56">
                                <Border Style="{StaticResource NavCardIconBorderStyle}">
                                    <FontIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="20" Glyph="&#xE7F3;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" Text="外观" l:Uids.Uid="Settings_Appearance_Title" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="1.0" FontSize="13" Text="窗口材质、背景图片、界面字体" l:Uids.Uid="Settings_Appearance_Desc" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Content>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="2" Padding="0,4,0,0">

                                <!-- 【UI 改版·第一批】主题选择：真实持久化（跟随系统/浅色/深色） -->
                                <Border x:Name="ThemeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid RowSpacing="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE793;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="主题" l:Uids.Uid="Settings_Add033" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="浅色 / 深色 / 跟随系统；选择即刻生效并保存，重启后恢复" l:Uids.Uid="Settings_Add034" />
                                            </StackPanel>
                                        </Grid>
                                        <RadioButtons x:Name="ThemeRadio" Grid.Row="1" MaxColumns="3" SelectionChanged="ThemeRadio_SelectionChanged">
                                            <RadioButtons.Resources>
                                                <ResourceDictionary Source="ms-appx:///Styles/AppearanceRadioThemeResources.xaml" />
                                            </RadioButtons.Resources>
                                            <RadioButton Content="跟随系统" Tag="system" l:Uids.Uid="Settings_Add035" />
                                            <RadioButton Content="浅色" Tag="light" l:Uids.Uid="Settings_Add036" />
                                            <RadioButton Content="深色" Tag="dark" l:Uids.Uid="Settings_Add037" />
                                        </RadioButtons>
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsBackdropCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid RowSpacing="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE7F3;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="窗口材质" l:Uids.Uid="Settings_Backdrop_Title" />
                                                <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="选择窗口背景的视觉材质效果，并可自定义色调" l:Uids.Uid="Settings_Backdrop_Desc" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BackdropMicaOption" Tag="Mica" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4" Background="#1A000000">
                                                        <Border CornerRadius="3" Margin="3" Background="#0CFFFFFF">
                                                            <Border CornerRadius="2" Margin="2" Background="#08FFFFFF" />
                                                        </Border>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Mica" />
                                                        <TextBlock FontSize="11" Opacity="1.0" Text="柔和云母" l:Uids.Uid="Settings_BackdropMica_Desc" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BackdropMicaAltOption" Grid.Column="1" Tag="MicaAlt" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4" Background="#2A000000">
                                                        <Border CornerRadius="3" Margin="3" Background="#14FFFFFF">
                                                            <Border CornerRadius="2" Margin="2" Background="#0AFFFFFF" />
                                                        </Border>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Mica Alt" />
                                                        <TextBlock FontSize="11" Opacity="1.0" Text="层次云母" l:Uids.Uid="Settings_BackdropMicaAlt_Desc" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BackdropAcrylicOption" Grid.Row="1" Tag="Acrylic" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4">
                                                        <Border.Background>
                                                            <AcrylicBrush TintColor="#FF202020" TintOpacity="0.8" TintLuminosityOpacity="0.3" />
                                                        </Border.Background>
                                                        <Border CornerRadius="3" Margin="4" Background="#18FFFFFF" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="亚克力" l:Uids.Uid="Settings_BackdropAcrylic_Title" />
                                                        <TextBlock FontSize="11" Opacity="1.0" Text="磨砂玻璃" l:Uids.Uid="Settings_BackdropAcrylic_Desc" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="BackdropAcrylicThinOption" Grid.Row="1" Grid.Column="1" Tag="AcrylicThin" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10,8" Tapped="BackdropOption_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="48" Height="32" CornerRadius="4">
                                                        <Border.Background>
                                                            <AcrylicBrush TintColor="#FF202020" TintOpacity="0.4" TintLuminosityOpacity="0.8" />
                                                        </Border.Background>
                                                        <Border CornerRadius="3" Margin="4" Background="#0CFFFFFF" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="细亚克力" l:Uids.Uid="Settings_BackdropAcrylicThin_Title" />
                                                        <TextBlock FontSize="11" Opacity="1.0" Text="更透亮的磨砂" l:Uids.Uid="Settings_BackdropAcrylicThin_Desc" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="2" Padding="12,10" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleSwitch x:Name="CustomTintToggle" Toggled="CustomTintToggle_Toggled" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontWeight="SemiBold" FontSize="13" Text="自定义色调" l:Uids.Uid="Settings_Tint_Title" />
                                                        <TextBlock FontSize="12" Opacity="1.0" TextWrapping="Wrap" Text="关闭时使用系统默认色调并自动跟随深浅主题；开启后使用自定义色调（深浅主题下保持一致）" l:Uids.Uid="Settings_Tint_Desc" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="CustomTintPanel" Spacing="10" Visibility="Collapsed">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel x:Name="TintSwatchPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border Tag="#FF202020" Width="26" Height="26" CornerRadius="13" Background="#FF202020" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FF000000" Width="26" Height="26" CornerRadius="13" Background="#FF000000" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FFFFFFFF" Width="26" Height="26" CornerRadius="13" Background="#FFFFFFFF" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FF0078D4" Width="26" Height="26" CornerRadius="13" Background="#FF0078D4" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FF7B2FF7" Width="26" Height="26" CornerRadius="13" Background="#FF7B2FF7" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FF107C10" Width="26" Height="26" CornerRadius="13" Background="#FF107C10" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FFCA5010" Width="26" Height="26" CornerRadius="13" Background="#FFCA5010" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                            <Border Tag="#FFC42B1C" Width="26" Height="26" CornerRadius="13" Background="#FFC42B1C" BorderThickness="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Tapped="TintSwatch_Tapped" PointerEntered="BackdropOption_PointerEntered" PointerExited="BackdropOption_PointerExited" />
                                                        </StackPanel>
                                                        <Button x:Name="CustomTintButton" Grid.Column="1" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border x:Name="CustomTintColorChip" Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#FF202020" />
                                                                <TextBlock Text="自定义颜色…" l:Uids.Uid="Settings_TintCustomColor" />
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <ColorPicker x:Name="TintColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" ColorChanged="TintColorPicker_ColorChanged" />
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="12" Opacity="1.0" VerticalAlignment="Center" Text="色调不透明度" l:Uids.Uid="Settings_TintOpacity_Label" />
                                                        <Slider x:Name="TintOpacitySlider" Grid.Column="1" ValueChanged="TintOpacitySlider_ValueChanged" />
                                                        <TextBlock x:Name="TintOpacityText" Grid.Column="2" FontSize="12" Opacity="1.0" VerticalAlignment="Center" Text="60%" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
