                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                            <TextBlock Text="新建自定义" FontSize="12" l:Uids.Uid="Settings_AiProvider_AddButton" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="AiResetProviderButton" Padding="12,6" Click="AiResetProviderButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                                            <TextBlock Text="恢复默认" FontSize="12" l:Uids.Uid="Settings_AiProvider_ResetButton" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- API 地址 -->
                                        <Grid Grid.Row="3" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
