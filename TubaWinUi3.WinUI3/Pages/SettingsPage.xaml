                    <!-- 【UI 改版·Raycast】AI 服务独立分组：提供商 / API Key / 模型（此前与硬件混放于"硬件与 AI"） -->
                    <Expander
                        x:Name="AiServiceExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" MinHeight="56">
                                <Border Style="{StaticResource NavCardIconBorderStyle}">
                                    <FontIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="20" Glyph="&#xE945;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" Text="AI 与 Agent" l:Uids.Uid="Settings_Add078" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="一次配置，聊天、工具流与资讯全局通用" l:Uids.Uid="Settings_Add079" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Content>
                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="2" Padding="0,4,0,0">

                                <Border x:Name="SettingsAiEndpointCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE945;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="Bold" Text="AI 接口与模型" l:Uids.Uid="Settings_Ai_Title" />
                                                <TextBlock x:Name="AiConfigStatusText" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="配置 AI 助手使用的提供商与模型" l:Uids.Uid="Settings_Add081" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Padding="0,1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- 提供商 -->
                                        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBorderStyle}">
                                                <FontIcon FontSize="18" Glyph="&#xE774;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8">
