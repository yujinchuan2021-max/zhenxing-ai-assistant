                                <Border x:Name="SettingsHardwareFitScreenCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE799;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="硬件信息一屏显示" l:Uids.Uid="Settings_HardwareFitScreen_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="自动缩放使所有硬件信息在一屏内显示，关闭后允许滚动浏览" l:Uids.Uid="Settings_HardwareFitScreen_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="HardwareFitScreenToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="HardwareFitScreenToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsHardwareMultiDeviceNewLineCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xE8FD;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="多设备换行显示" l:Uids.Uid="Settings_HardwareMultiDevice_Title" />
                                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="当存在多个显卡、硬盘等设备时，每个设备单独一行显示" l:Uids.Uid="Settings_HardwareMultiDevice_Desc" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="HardwareMultiDeviceNewLineToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="HardwareMultiDeviceNewLineToggle_Toggled" />
                                    </Grid>
                                </Border>

                                <Border x:Name="SettingsCpuzDataSourceCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBorderStyle}">
                                            <FontIcon FontSize="18" Glyph="&#xEEA1;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="Bold" Text="硬件信息数据源" l:Uids.Uid="Settings_CpuzSource_Title" />
                                            <TextBlock x:Name="CpuzDataSourceStatusText" Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="使用 CPU-Z 读取真实硬件信息，防止厂商伪造" l:Uids.Uid="Settings_CpuzSource_Status" />
                                        </StackPanel>
                                        <Button x:Name="CpuzDataSourceButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,6" Click="CpuzDataSourceButton_Click">
