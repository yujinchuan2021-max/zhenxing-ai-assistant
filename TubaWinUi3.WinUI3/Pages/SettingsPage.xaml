                                                    <TextBlock x:Name="BgListEmptyText" Opacity="1.0" FontSize="13" Text="还没有导入过图片" Visibility="Collapsed" l:Uids.Uid="Settings_BgHistory_Empty" />
                                                </StackPanel>
                                            </Expander.Content>
                                        </Expander>
                                    </Grid>
                                </Border>



                                <!-- 界面字体（目录化候选，顺序来自 Assets/Fonts/app-font.json；选择在下次启动应用时生效） -->
                                <Border x:Name="SettingsUiFontCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
