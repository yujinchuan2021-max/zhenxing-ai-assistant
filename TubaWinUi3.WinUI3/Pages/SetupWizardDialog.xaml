<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.SetupWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid RowSpacing="20" MinWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="StepTitleText"
                FontSize="20"
                FontWeight="Bold" />
            <TextBlock
                x:Name="StepSubtitleText"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <PipsPager
            x:Name="StepPager"
            Grid.Row="1"
            HorizontalAlignment="Left"
            NumberOfPages="3"
            SelectedPageIndex="0"
            Visibility="Visible" />

        <Grid Grid.Row="2" MinHeight="220">
            <StackPanel
                x:Name="Step0Content"
                Spacing="20"
                Visibility="Visible"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE946;"
                    HorizontalAlignment="Center" />

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center">
                    <Run Text="枕星官网：" l:Uids.Uid="Wizard_Static001" /><Underline><Run x:Name="WebsiteRun" Text="zhenxingai.com" /></Underline>
                </TextBlock>

                <HyperlinkButton
                    x:Name="VisitWebsiteButton"
                    Content="访问官网"
                    NavigateUri="https://zhenxingai.com"
                    HorizontalAlignment="Center"
                    FontSize="14" l:Uids.Uid="Wizard_Static002" />

                <Border
                    Padding="16,12"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            HorizontalAlignment="Center"
                            Text="⚠ 该软件开源免费！" l:Uids.Uid="Wizard_Static003" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="如果你是付费获得的，说明你被骗了！！！" l:Uids.Uid="Wizard_Static004" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                x:Name="Step1Content"
                Spacing="16"
                Visibility="Collapsed">

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选择窗口背景材质效果：" l:Uids.Uid="Wizard_Static005" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="BackdropMicaOption"
                        Tag="Mica"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="Mica">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#1a1a2e" />
                                        <GradientStop Offset="0.5" Color="#16213e" />
                                        <GradientStop Offset="1" Color="#0f3460" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border
                                    Margin="6"
                                    Padding="4"
                                    Background="#99ffffff"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="#1a1a2e"
                                        HorizontalAlignment="Center"
                                        Text="Mica" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="Mica" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="柔和云母效果" l:Uids.Uid="Wizard_Static006" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="BackdropMicaAltOption"
                        Grid.Column="1"
                        Tag="MicaAlt"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="Mica Alt">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#2d1b69" />
                                        <GradientStop Offset="0.5" Color="#11998e" />
                                        <GradientStop Offset="1" Color="#38ef7d" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border
                                    Margin="6"
                                    Padding="4"
                                    Background="#99ffffff"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="#2d1b69"
                                        HorizontalAlignment="Center"
                                        Text="Mica Alt" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="Mica Alt" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="层次更丰富的云母" l:Uids.Uid="Wizard_Static007" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="BackdropAcrylicOption"
                        Grid.Column="2"
                        Tag="Acrylic"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Tapped="BackdropOption_Tapped"
                        AutomationProperties.Name="亚克力" l:Uids.Uid="Wizard_Static008">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="80"
                                Height="52"
                                CornerRadius="8"
                                HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#667eea" />
                                        <GradientStop Offset="1" Color="#764ba2" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border
                                    Margin="6"
                                    Padding="4"
                                    Background="#88ffffff"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="#764ba2"
                                        HorizontalAlignment="Center"
                                        Text="Acrylic" />
                                </Border>
                            </Border>
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Text="亚克力" l:Uids.Uid="Wizard_Static009" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="磨砂玻璃模糊效果" l:Uids.Uid="Wizard_Static010" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="Step2Content"
                Spacing="16"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE721;"
                    HorizontalAlignment="Center" />

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="400"
                    Text="开启后，工具箱会为每个工具在开始菜单创建快捷方式。&#x0a;你可以直接按 Win 键搜索工具名称（如「CPU-Z」「GPU-Z」）来快速启动，无需先打开工具箱。&#x0a;支持多版本自动去重，卸载工具箱时会自动清理。" l:Uids.Uid="Wizard_Static011" />

                <Border
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBorderStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE721;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="Bold" Text="注册到 Windows 搜索" l:Uids.Uid="Wizard_Static012" />
                            <TextBlock Opacity="1.0" FontSize="13" TextWrapping="Wrap" Text="按 Win 键搜索工具名直接启动，无需先打开工具箱" l:Uids.Uid="Wizard_Static013" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WizardSearchIndexToggle" Grid.Column="2" VerticalAlignment="Center" IsOn="False" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
