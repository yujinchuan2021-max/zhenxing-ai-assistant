<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TubaWinUi3.Pages.GameTunnelJoinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="我要加入" l:Uids.Uid="Gt_L2"
    PrimaryButtonText="下一步"
    SecondaryButtonText="上一步"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="450"
        MinWidth="540"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="12">

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="第 1 步 / 共 2 步" l:Uids.Uid="Gt_StepText" />
                <TextBlock x:Name="StepNameText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· 粘贴邀请" l:Uids.Uid="Gt_StepNameText" />
            </StackPanel>

            <!-- ══════════ 第 1 步：邀请码 / 地址 ══════════ -->
            <StackPanel x:Name="Step1Panel" Spacing="10">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="把对方发来的邀请码整段粘进来就行（连说明文字一起粘也可以）。如果对方只给了地址，直接填 100.x.x.x:端口。" l:Uids.Uid="Gt_L41" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="InviteBox"
                        PlaceholderText="TBG1:… 或 100.101.102.103:25565" l:Uids.Uid="Gt_InviteBox"
                        TextChanged="InviteBox_TextChanged"
                        FontFamily="{ThemeResource AppFontFamily}"
                        FontSize="12" />
                    <Button x:Name="PasteButton" Grid.Column="1" Click="Paste_Click" Padding="12,6" CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE77F;" />
                            <TextBlock FontSize="13" Text="粘贴" l:Uids.Uid="Gt_L61" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    x:Name="PreviewCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PreviewTitle" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewAddress" FontSize="18" FontFamily="{ThemeResource AppFontFamily}" FontWeight="Bold" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PreviewNote" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════════ 第 2 步：连接 ══════════ -->
            <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">

                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="JoinIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="JoinText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Text="等待开始" l:Uids.Uid="Gt_JoinText" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="AddressIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="AddressText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Text="本机联机地址" l:Uids.Uid="Gt_AddressText" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="PingIcon" FontSize="14" Glyph="&#xE9F5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="PingText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Text="与对方的连接" l:Uids.Uid="Gt_PingText" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 需要切换网络时的确认（ContentDialog 不能再嵌套，所以就地确认） -->
                <Border
                    x:Name="SwitchWarningCard"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="这一步会切换你的 Tailscale 网络" l:Uids.Uid="Gt_L131" />
                        </StackPanel>
                        <TextBlock x:Name="SwitchWarningText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConfirmSwitchButton" Click="ConfirmSwitch_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7" Content="确认切换并继续" l:Uids.Uid="Gt_ConfirmSwitchButton" FontSize="13" />
                            <Button x:Name="SkipSwitchButton" Click="SkipSwitch_Click" CornerRadius="7" Padding="14,7" Content="先跳过" l:Uids.Uid="Gt_SkipSwitchButton" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="JoinProgress" Visibility="Collapsed" />
            </StackPanel>

            <!-- ══════════ 第 3 步：就绪 ══════════ -->
            <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">

                <Border Padding="16,14" BorderThickness="1" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#1F2BB673" />
                            <GradientStop Offset="1" Color="#1F5B8DEF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#402BB673" />
                    </Border.BorderBrush>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="连上了，现在打开游戏" l:Uids.Uid="Gt_L160" />
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="在游戏里连接这个地址：" l:Uids.Uid="Gt_L162" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                x:Name="FinalAddressText"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource AppFontFamily}"
                                FontSize="26"
                                FontWeight="Bold"
                                IsTextSelectionEnabled="True"
                                Text="--" />
                            <Button x:Name="CopyFinalAddressButton" Click="CopyFinalAddress_Click" CornerRadius="7" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    <TextBlock FontSize="13" Text="复制" l:Uids.Uid="Gt_L175" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="FinalNoteText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Header="在游戏里怎么填？" l:Uids.Uid="Gt_L183" HorizontalAlignment="Stretch" IsExpanded="True">
                    <ItemsControl x:Name="GuestStepsList" Padding="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Top" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="•" l:Uids.Uid="Gt_L192" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="连不上？" l:Uids.Uid="Gt_L205" HorizontalAlignment="Stretch">
                    <StackPanel Padding="0,8" Spacing="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 提示「未知主机 / 服务器无响应」：先回游戏主菜单重进一次，或者让对方确认游戏还开着。" l:Uids.Uid="Gt_L207" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 一直连不上：回到工具箱主页点「网络检测」，看和对方是直连还是中继、有没有告警。" l:Uids.Uid="Gt_L212" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="· 玩完想恢复正常网络：右键任务栏的 Tailscale 图标选择 Disconnect，或者用托盘菜单切回你自己的账号。" l:Uids.Uid="Gt_L217" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
