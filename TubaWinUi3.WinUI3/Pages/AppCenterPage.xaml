<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="TubaWinUi3.Pages.AppCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:appmgmt="using:TubaWinUi3.Services.AppManagement"
      NavigationCacheMode="Enabled">
    <Page.Resources>
        <DataTemplate x:Key="AppItemTemplate" x:DataType="appmgmt:AppCenterItem">
            <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="8" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon FontSize="18" VerticalAlignment="Top" Glyph="{x:Bind Glyph}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind Version}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Detail}" FontSize="12"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6" Orientation="Horizontal"
                                HorizontalAlignment="Stretch" SizeChanged="CardActions_SizeChanged">
                        <Button Content="{x:Bind PrimaryLabel}" Tag="{Binding}" IsEnabled="{x:Bind PrimaryEnabled}"
                                Style="{ThemeResource AccentButtonStyle}" Click="PrimaryAction_Click"/>
                        <Button Content="打开当前版本" Tag="{Binding}" Click="OpenTool_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(ShowOpen)}"/>
                        <Button Content="打开位置" Tag="{Binding}" Click="OpenFolder_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(ShowLocation)}"/>
                        <Button Content="创建桌面图标" Tag="{Binding}" Click="CreateShortcut_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(CanCreateShortcut)}"/>
                        <Button Content="移除下载包" Tag="{Binding}" Click="RemoveCloud_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(CanRemoveManaged)}"/>
                        <Button Content="移除记录" Tag="{Binding}" Click="RemoveRecord_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(ShowRemove)}"/>
                        <Button Content="检查安装状态" Tag="{Binding}" Click="CheckInstallation_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(ShowPackageCheck)}"/>
                        <Button Content="Windows 应用设置" Tag="{Binding}" Click="SystemApps_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(ShowSystemApps)}"/>
                        <Button Content="卸载" Tag="{Binding}" Click="Uninstall_Click"
                                IsEnabled="{x:Bind SecondaryEnabled}"
                                Visibility="{x:Bind appmgmt:AppCenterService.BoolToVisibility(CanUninstall)}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="24,18" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="应用中心" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="管理本机已有的软件，查看更新和下载任务。需要新工具，可到「图吧工具」选择。"/>
        </StackPanel>
        <StackPanel x:Name="Toolbar" Grid.Row="1" Spacing="8" Orientation="Horizontal" SizeChanged="Toolbar_SizeChanged">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索软件、用途或版本" MinWidth="170" Width="260" MaxLength="100" TextChanged="FilterChanged"/>
            <ComboBox x:Name="StatusFilter" MinWidth="145" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="全部状态" Tag="all"/><ComboBoxItem Content="已安装" Tag="installed"/>
                <ComboBoxItem Content="需处理" Tag="attention"/><ComboBoxItem Content="可更新" Tag="update"/>
                <ComboBoxItem Content="正在处理" Tag="busy"/><ComboBoxItem Content="入口待确认" Tag="missing"/>
            </ComboBox>
            <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/>
            <Button x:Name="RegisterButton" Content="登记已安装的软件" Click="RegisterSoftware_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="5">
            <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="FeedbackText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"/>
        </StackPanel>
        <ScrollViewer Grid.Row="3" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel x:Name="CloudSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="我的工具" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="CloudEmpty" Text="没有符合筛选条件的本机工具或下载任务。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind CloudItems}" ItemTemplate="{StaticResource AppItemTemplate}"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="已登记软件与应用管理环境" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="SandboxEmpty" Text="暂时没有匹配的登记记录。可以选择程序文件或文件夹登记。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind SandboxItems}" ItemTemplate="{StaticResource AppItemTemplate}"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="本机开发环境" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="EnvEmpty" Text="暂无匹配的开发环境。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind EnvItems}" ItemTemplate="{StaticResource AppItemTemplate}"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="本机 AI 工具" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="AiEmpty" Text="暂无匹配的 AI 工具。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind AiItems}" ItemTemplate="{StaticResource AppItemTemplate}"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="本应用与内核" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind CoreItems}" ItemTemplate="{StaticResource AppItemTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
