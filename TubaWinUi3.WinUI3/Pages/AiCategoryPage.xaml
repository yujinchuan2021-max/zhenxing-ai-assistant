<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TubaWinUi3.Pages.AiCategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TubaWinUi3.Pages"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,20,28,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="DescText" FontSize="14" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="CategoryHintText"
            Grid.Row="1"
            FontSize="12"
            Opacity="0.55"
            TextWrapping="Wrap"
            Text="提示：每张卡都能「⬇ 一键安装」（本应用直接装，不需要 AI）；想自己来就点卡片打开官网下载页；点「AI 安装」交给主页 AI 助手手把手带你装好、教会你用（需先配置 API）。" />

        <GridView
            x:Name="CardGrid"
            Grid.Row="2"
            IsItemClickEnabled="True"
            ItemClick="CardGrid_ItemClick"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:AiToolCard">
                    <Border
                        Width="258"
                        MinHeight="250"
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid Width="30" Height="30" HorizontalAlignment="Left">
                                    <FontIcon
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind GlyphVisibility}" />
                                    <Image
                                        Width="30"
                                        Height="30"
                                        Stretch="Uniform"
                                        Source="{x:Bind IconSource}"
                                        Visibility="{x:Bind IconVisibility}" />
                                </Grid>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="ToggleAiFav_Click"
                                    Content="{x:Bind FavText}"
                                    FontSize="15"
                                    Tag="{x:Bind Name}"
                                    ToolTipService.ToolTip="{x:Bind FavoriteToolTip}" />
                            </Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                Height="72"
                                FontSize="13"
                                Opacity="0.72"
                                Text="{x:Bind DescDisplay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="{x:Bind ReplacedText}"
                                Visibility="{x:Bind ReplacedVisibility}" />
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Click="AiInstall_Click"
                                        Content="{x:Bind AiInstallText}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Tag="{x:Bind Name}"
                                        Visibility="{x:Bind AiInstallVisibility}"
                                        ToolTipService.ToolTip="{x:Bind AiInstallToolTip}" />
                                    <Button
                                        Click="QuickInstall_Click"
                                        Content="{x:Bind QuickInstallText}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Tag="{x:Bind Name}"
                                        Visibility="{x:Bind QuickInstallVisibility}"
                                        ToolTipService.ToolTip="{x:Bind QuickInstallToolTip}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            FontSize="11"
                            Opacity="0.55"
                            Text="{x:Bind OpenOfficialText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
