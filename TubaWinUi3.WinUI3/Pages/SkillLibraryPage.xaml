<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TubaWinUi3.Pages.SkillLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Enabled">
    <Grid x:Name="Root" Padding="24" RowSpacing="16" MaxWidth="1320" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Header" Spacing="12" />
        <!-- A finite viewport supplies the virtualizing masonry layout with its
             realization rectangle. Never wrap this in an outer StackPanel. -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="1" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="Cards" VerticalCacheLength="1" HorizontalCacheLength="0">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Badge}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding AuthorCredit}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DetailsVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Heat}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DetailsVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="{Binding DetailsLabel}" Visibility="{Binding DetailsVisibility}"
                                        HorizontalAlignment="Left" Click="Details_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
