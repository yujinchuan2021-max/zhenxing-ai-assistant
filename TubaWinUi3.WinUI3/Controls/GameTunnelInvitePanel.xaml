<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TubaWinUi3.Controls.GameTunnelInvitePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel MinWidth="470" Spacing="12">

        <!-- 生成中 -->
        <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="10" Padding="4,18" Visibility="Collapsed">
            <ProgressRing Width="20" Height="20" IsActive="True" />
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" FontSize="13" Text="正在生成邀请码…" l:Uids.Uid="Gt_BusyText" />
        </StackPanel>

        <!-- 还缺邀请密钥：内联引导（不用再开对话框） -->
        <StackPanel x:Name="KeyPromptPanel" Spacing="10" Visibility="Collapsed">
            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="还差一步：需要一个邀请密钥" l:Uids.Uid="Gt_L29" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="朋友要「一键加入」你的网络，需要一把短期有效的密钥。配置一次 API 密钥后，本工具以后会自动生成；也可以每次手动创建。" l:Uids.Uid="Gt_L31" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UseApiKeyButton" Click="UseApiKey_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                                <TextBlock FontSize="13" Text="配置 API 密钥（一次即可）" l:Uids.Uid="Gt_L41" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ManualKeyButton" Click="ManualKey_Click" CornerRadius="7" Padding="14,7">
                            <TextBlock FontSize="13" Text="手动创建密钥" l:Uids.Uid="Gt_L45" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- API 密钥内联表单 -->
            <Border
                x:Name="ApiKeyForm"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="粘贴 Tailscale API 访问令牌" l:Uids.Uid="Gt_L61" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="在控制台 Keys 页面生成，以 tskey-api- 开头。令牌只保存在本机数据目录，用于自动创建邀请密钥。" l:Uids.Uid="Gt_L62" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="Wrap"
                        Text="不用手动粘贴：在控制台点「复制」后回到本窗口，这里会自动填入并验证。" l:Uids.Uid="Gt_L67" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ApiKeyBox" Grid.Column="0" PlaceholderText="tskey-api-…" l:Uids.Uid="Gt_ApiKeyBox" FontFamily="{ThemeResource AppFontFamily}" />
                        <Button x:Name="ApiKeyPasteButton" Grid.Column="1" Click="PasteApiKey_Click" CornerRadius="7" Padding="12,6" Content="粘贴" l:Uids.Uid="Gt_ApiKeyPasteButton" FontSize="13" VerticalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApiKeySaveButton" Click="ApiKeySave_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7" Content="验证并保存" l:Uids.Uid="Gt_ApiKeySaveButton" FontSize="13" />
                        <Button x:Name="ApiKeyHelpButton" Click="OpenKeysPage_Click" CornerRadius="7" Padding="14,7" Content="打开 Keys 页面" l:Uids.Uid="Gt_ApiKeyHelpButton" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="ApiKeyError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 手动密钥内联表单 -->
            <Border
                x:Name="ManualKeyForm"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="在控制台手动创建一个授权密钥" l:Uids.Uid="Gt_L98" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Keys 页面 →「Generate auth key」→ 勾选 Reusable 与 Pre-approved → Generate key。" l:Uids.Uid="Gt_L99" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="Wrap"
                        Text="同样不用手动粘贴：生成后点「复制」，回到本窗口会自动填入。" l:Uids.Uid="Gt_L104" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualKeyBox" Grid.Column="0" PlaceholderText="tskey-auth-…" l:Uids.Uid="Gt_ManualKeyBox" FontFamily="{ThemeResource AppFontFamily}" />
                        <Button x:Name="ManualKeyPasteButton" Grid.Column="1" Click="PasteAuthKey_Click" CornerRadius="7" Padding="12,6" Content="粘贴" l:Uids.Uid="Gt_ManualKeyPasteButton" FontSize="13" VerticalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ManualKeyApplyButton" Click="ManualKeyApply_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7" Content="使用这个密钥" l:Uids.Uid="Gt_ManualKeyApplyButton" FontSize="13" />
                        <Button x:Name="ManualKeyHelpButton" Click="OpenKeysPage_Click" CornerRadius="7" Padding="14,7" Content="打开 Keys 页面" l:Uids.Uid="Gt_ManualKeyHelpButton" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="ManualKeyError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 就绪：三种给朋友的方式 -->
        <StackPanel x:Name="ReadyPanel" Spacing="12" Visibility="Collapsed">

            <!-- 邀请码 -->
            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8F1;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="邀请码（朋友也装了图吧工具箱）" l:Uids.Uid="Gt_L139" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="把那行邀请说明发给朋友，他在「游戏联机助手 → 我要加入」里粘贴即用。" l:Uids.Uid="Gt_L141" />
                    <TextBlock
                        x:Name="InviteDirectNote"
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="InviteCodeBox"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="False"
                        FontFamily="{ThemeResource AppFontFamily}"
                        FontSize="12"
                        MaxHeight="70" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyCodeButton" Click="CopyCode_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                <TextBlock FontSize="13" Text="复制邀请码" l:Uids.Uid="Gt_L163" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyMessageButton" Click="CopyMessage_Click" CornerRadius="7" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                                <TextBlock FontSize="13" Text="复制完整说明" l:Uids.Uid="Gt_L169" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RevokeButton" Click="Revoke_Click" CornerRadius="7" Padding="12,7" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                            <TextBlock FontSize="13" Text="撤销邀请码" l:Uids.Uid="Gt_L173" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ExpiryText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 一键加入脚本 -->
            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE756;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="一键加入脚本（朋友没装工具箱）" l:Uids.Uid="Gt_L190" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="生成一个 .cmd 文件发给朋友，双击后它会自动装好 Tailscale 并连上你，全程无需配置。" l:Uids.Uid="Gt_L192" />
                    <TextBlock
                        x:Name="ScriptDirectNote"
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveScriptButton" Click="SaveScript_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE74E;" />
                                <TextBlock FontSize="13" Text="保存脚本…" l:Uids.Uid="Gt_L206" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenScriptsFolderButton" Click="OpenScriptsFolder_Click" CornerRadius="7" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE838;" />
                                <TextBlock FontSize="13" Text="打开所在文件夹" l:Uids.Uid="Gt_L212" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ScriptHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 直接给地址 -->
            <Border
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE774;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="只发地址（需要对方已经在你的网络里）" l:Uids.Uid="Gt_L230" />
                    </StackPanel>
                    <TextBlock
                        x:Name="AddressOnlyPreconditionText"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="不想解释这些？用上面的邀请码或一键加入脚本——那条路会把他直接加进你的网络，不需要任何人同意。" l:Uids.Uid="Gt_L237" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="12,7"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="7"
                            VerticalAlignment="Center">
                            <TextBlock x:Name="AddressText" FontFamily="{ThemeResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Text="--" IsTextSelectionEnabled="True" />
                        </Border>
                        <Button x:Name="CopyAddressButton" Click="CopyAddress_Click" CornerRadius="7" Padding="14,7" Content="复制地址" l:Uids.Uid="Gt_CopyAddressButton" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="提示：朋友加入后，会在你的 Tailscale 控制台里多出一台设备；邀请密钥到期后这些设备不会被自动删除，需要时可在控制台 Machines 页面移除。" l:Uids.Uid="Gt_L255" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Success" />
    </StackPanel>
</UserControl>
