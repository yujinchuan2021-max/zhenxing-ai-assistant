<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Controls.AgentChat.ReasoningDisclosureControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10,8">
        <StackPanel Spacing="8">
            <Button x:Name="HeaderButton" HorizontalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="2"
                    Click="HeaderButton_Click"
                    AutomationProperties.Name="展开或折叠思考过程">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18">
                        <ProgressRing x:Name="ThinkingProgress" Width="16" Height="16" IsActive="True" />
                        <FontIcon x:Name="ThinkingIcon" Glyph="&#xE945;" FontSize="12"
                                  Visibility="Collapsed"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TitleText" Text="正在思考…" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="MetaText" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <FontIcon x:Name="Chevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <Grid x:Name="ContentPanel">
                <TextBlock x:Name="ReasoningText" FontSize="12" LineHeight="19"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
