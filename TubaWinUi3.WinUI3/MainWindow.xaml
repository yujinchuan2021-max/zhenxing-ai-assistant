<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TubaWinUi3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TubaWinUi3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="枕星图吧AI助手"
    xmlns:controls="using:TubaWinUi3.Controls"
    mc:Ignorable="d">

    <Grid PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <local:IconPathToVisibilityConverter x:Key="IconPathToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SplashOverlay"
              Grid.RowSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Canvas.ZIndex="9999"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Width="96"
                    Height="96"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="20"
                    HorizontalAlignment="Center">
                    <Image
                        Width="64"
                        Height="64"
                        Source="ms-appx:///Assets/AppIcon.ico"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="SplashTitleText"
                        FontSize="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Text="枕星图吧AI助手" />
                    <TextBlock
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Opacity="0.6"
                        x:Name="SplashStatusText"
                        Text="正在初始化..." />
                </StackPanel>

                <ProgressBar
                    x:Name="SplashProgress"
                    Grid.Row="2"
                    Width="200"
                    IsIndeterminate="True"
                    HorizontalAlignment="Center" />

                <TextBlock
                    x:Name="SplashVersionText"
                    Grid.Row="3"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Opacity="0.4" />
            </Grid>
        </Grid>

        <TitleBar
            x:Name="AppTitleBar"
            Title=""
            FontFamily="{ThemeResource AppFontFamily}"
            FontWeight="Bold"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid x:Name="TitleBarContentGrid" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The framework Title text uses a fixed Caption style. Own this text node
                         so the packaged font applies without replacing the TitleBar template. -->
                    <TextBlock
                        x:Name="AppTitleText"
                        Grid.Column="0"
                        Text="枕星图吧AI助手"
                        FontFamily="{ThemeResource AppFontFamily}"
                        FontSize="12"
                        FontWeight="Normal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        IsHitTestVisible="False"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Column="1" Width="320">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            PlaceholderText="搜索工具、设置..."
                            QueryIcon="Find"
                            VerticalAlignment="Center"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted" />
                        <Popup
                            x:Name="SearchPopup"
                            VerticalOffset="32"
                            GettingFocus="SearchPopup_GettingFocus">
                            <Popup.Transitions>
                                <TransitionCollection>
                                    <PopupThemeTransition />
                                </TransitionCollection>
                            </Popup.Transitions>
                            <Border
                                x:Name="SearchPopupBorder"
                                Width="318"
                                MaxHeight="400"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                                <ListView
                                    x:Name="SearchListView"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    KeyDown="SearchListView_KeyDown"
                                    ItemClick="SearchListView_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="4,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Image
                                                            Width="24" Height="24"
                                                            Stretch="Uniform"
                                                            Source="{Binding IconPath}"
                                                            Visibility="{Binding HasIconPath, Converter={StaticResource IconPathToVisibility}}" />
                                                        <FontIcon
                                                            FontSize="14"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Glyph="{Binding Glyph}"
                                                            Visibility="{Binding HasIconPath, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock

                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        MaxLines="1"
                                                        Text="{Binding TitleDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock

                                                        FontSize="11"
                                                        Opacity="1.0"
                                                        MaxLines="1"
                                                        Text="{Binding SubtitleDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="2"
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center">
                                                    <TextBlock

                                                        FontSize="10"
                                                        Text="{Binding KindText}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Button
                            x:Name="LanguageToggleButton"
                            Click="LanguageToggleButton_Click"
                            Content="中 → EN"
                            MinWidth="66"
                            Height="30"
                            Padding="8,0"
                            AutomationProperties.Name="切换为英文"
                            ToolTipService.ToolTip="切换为英文" />
                        <Button
                            x:Name="AiQuickButton"
                            Click="AiQuickButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="AI 助手"
                            AutomationProperties.Name="AI 助手">
                            <FontIcon FontSize="14" Glyph="&#xE99A;" />
                        </Button>


                        <Button
                            x:Name="DownloadQueueButton"
                            Click="DownloadQueueButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            AutomationProperties.Name="下载队列">
                            <Grid>
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <InfoBadge
                                    x:Name="DownloadQueueBadge"
                                    Value="0"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,-4,-4,0" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="TitleBarSettingsButton"
                            Click="TitleBarSettingsButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="设置"
                            AutomationProperties.Name="设置">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                        </Button>

                        <Button
                            x:Name="TitleBarAppCenterButton"
                            Click="TitleBarAppCenterButton_Click"
                            Width="34" Height="30"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTipService.ToolTip="应用中心"
                            AutomationProperties.Name="应用中心">
                            <FontIcon FontSize="14" Glyph="&#xE719;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <StackPanel Grid.Row="1">
            <controls:UpdateBanner x:Name="UpdateBanner" />
            <InfoBar
                x:Name="ToolUpdateToast"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Image
                x:Name="BackgroundImg"
                Stretch="UniformToFill"
                Opacity="0.15"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False" />

            <NavigationView
                x:Name="NavView"
                CompactModeThresholdWidth="0"
                ExpandedModeThresholdWidth="600"
                CompactPaneLength="62"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                OpenPaneLength="200"
                PaneDisplayMode="Left"
                IsPaneOpen="False"
                IsSettingsVisible="False"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="主页" Tag="home" ToolTipService.ToolTip="主页">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <!-- ZXAI 2026-09-22：收藏页从顶栏迁至"主页"下方（用户口径），顶栏收藏按钮已删 -->
                    <NavigationViewItem Content="官方技能库" Tag="skill-library" ToolTipService.ToolTip="官方技能库">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="收藏" Tag="favorites" ToolTipService.ToolTip="收藏">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE735;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="硬件信息" Tag="hardware" ToolTipService.ToolTip="硬件信息">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE977;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <!-- ZXAI 2026-09-23：枕星AI社区（顶级入口，独立于「图吧工具」的社区工具分摊；
                         社区=用户交流与经验分享，不是工具下载列表，Tag 与旧「社区」频道无关联）。 -->
                    <NavigationViewItem Content="枕星AI资讯" Tag="ai-news" ToolTipService.ToolTip="枕星AI资讯">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="枕星AI社区" Tag="community-hub" ToolTipService.ToolTip="枕星AI社区（交流与经验分享）">
                        <NavigationViewItem.Icon>
                            <ImageIcon Source="ms-appx:///Assets/zxai-logo.png" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Name="AiToolsGroup" Content="AI 工具" IsExpanded="False" SelectsOnInvoked="False" ToolTipService.ToolTip="AI 工具">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE99A;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                        <!-- ZXAI 折叠组(2026-09-20)：子项平铺，折叠用 Visibility 控制，绕开 NavView 内部折叠逻辑 -->
                            <NavigationViewItem Content="聊天助手" Tag="ai-cat:assistant" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE99A;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="AI agent" Tag="ai-cat:agent" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE99A;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="AI 本地部署" Tag="ai-cat:local" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE7F8;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="AI 模型" Tag="ai-cat:models" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8F1;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="软件开发" Tag="ai-cat:dev" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE943;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="游戏开发" Tag="ai-cat:game" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE7FC;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="办公效率" Tag="ai-cat:office" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="内容创作" Tag="ai-cat:create" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE714;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="图像设计" Tag="ai-cat:image" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE790;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="视频制作" Tag="ai-cat:video" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE714;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="音频制作" Tag="ai-cat:audio" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE8D6;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="文案写作" Tag="ai-cat:writing" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="翻译工具" Tag="ai-cat:translate" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE774;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                    <NavigationViewItem x:Name="TubaToolsGroup" Content="图吧工具" IsExpanded="False" SelectsOnInvoked="False" ToolTipService.ToolTip="图吧工具">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;" FontWeight="Bold" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                        <!-- ZXAI 折叠组(2026-09-20)：子项平铺，折叠用 Visibility 控制，绕开 NavView 内部折叠逻辑 -->
                            <NavigationViewItem Content="全部工具" Tag="all" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE71D;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="内置" Tag="builtin" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE90F;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="性能测试" Tag="benchmark" Margin="28,0,0,0">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE9D9;" FontWeight="Bold" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <!-- ZXAI 2026-09-23：社区频道已删除（用户口径）——社区工具已分摊到各分类页，社区卡同步显示。 -->
                </NavigationView.MenuItems>
                <Frame x:Name="NavFrame" CacheSize="10" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>
