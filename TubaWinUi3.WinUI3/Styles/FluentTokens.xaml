<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        图吧工具箱 Fluent 设计令牌（基准：WinUI 3 XAML Controls Gallery）
        - 间距遵循 8px 网格：4 / 8 / 12 / 16 / 24 / 32
        - 圆角令牌：控件 4 / 卡片与浮层 8 / 药丸 12
        - 版式阶梯：Caption 12 / Body 14 / Subtitle 20 / Title 28（字体统一由 App.xaml 的
          AppFontFamily 隐式样式 + 本文件各 TextStyle 的 FontFamily Setter 提供）
        - 颜色一律使用官方 {ThemeResource} 语义画笔，禁止硬编码
    -->

    <!-- 数据可视化系列色板（图表/仪表盘专用，跟随主题） -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DataSeries1Brush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="DataSeries2Brush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DataSeries3Brush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="DataSeries4Brush" Color="{ThemeResource SystemFillColorCaution}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DataSeries1Brush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="DataSeries2Brush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="DataSeries3Brush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="DataSeries4Brush" Color="{ThemeResource SystemFillColorCaution}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DataSeries1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataSeries2Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataSeries3Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataSeries4Brush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 间距令牌（8px 网格） -->
    <x:Double x:Key="SpaceXxSmall">4</x:Double>
    <x:Double x:Key="SpaceXSmall">8</x:Double>
    <x:Double x:Key="SpaceSmall">12</x:Double>
    <x:Double x:Key="SpaceMedium">16</x:Double>
    <x:Double x:Key="SpaceLarge">24</x:Double>
    <x:Double x:Key="SpaceXLarge">32</x:Double>

    <!-- 圆角令牌 -->
    <x:Double x:Key="ControlCornerRadiusToken">4</x:Double>
    <x:Double x:Key="CardCornerRadiusToken">8</x:Double>
    <x:Double x:Key="DialogCornerRadiusToken">8</x:Double>
    <x:Double x:Key="PillCornerRadiusToken">12</x:Double>

    <!-- 版式阶梯样式（ZXAI 字体统一：显式样式也显式声明 FontFamily——
         有 Style 的 TextBlock 不吃隐式样式，且框架命名样式基类带 XamlAutoFontFamily 字面量） -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 卡片：官方 Card 背景 + 描边，圆角 8，内边距 16 -->
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 图标瓦片 -->
    <Style x:Key="IconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
        内置工具页统一页头（Controls/ToolPageHeader）
        - 返回按钮直接复用 WinUI 3 官方独立返回按钮规范 TitleBarBackButtonStyle：
          40×32 前导箭头（\uE72B）、淡雅底色（SubtleFillColorTransparent/Secondary/Tertiary）、
          模板内含 AnimatedIcon + AnimatedBackVisualSource 回退动画。
          官方依据：https://learn.microsoft.com/windows/apps/develop/ui/navigation/navigation-history-and-backwards-navigation
        - 版式：标题 20 SemiBold、副标题 12 次要色，均单行省略
    -->
    <Style x:Key="ToolPageBackButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarBackButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="ToolPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ToolPageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
