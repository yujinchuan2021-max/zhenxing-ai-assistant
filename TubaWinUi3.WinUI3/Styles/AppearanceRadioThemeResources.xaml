<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Only the three appearance choices use these keys. Native RadioButton
         selection, keyboard navigation and check-glyph states remain intact. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RadioButtonForeground" Color="#2B2B30" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="#2B2B30" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="#2B2B30" />
            <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="#656670" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RadioButtonForeground" Color="#EDEDF0" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="#EDEDF0" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="#EDEDF0" />
            <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="#9F9FAC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RadioButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
