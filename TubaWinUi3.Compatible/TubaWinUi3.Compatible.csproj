<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TubaWinUi3.Compatible</RootNamespace>
    <ApplicationIcon>..\TubaWinUi3.WinUI3\Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>图吧工具箱Winui3兼容版</AssemblyName>
    <Version>1.0.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="All" />
    <PackageReference Include="Fody" Version="6.8.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TubaWinUi3.WinUI3\Assets\AppIcon.ico">
      <Link>Assets\AppIcon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- ZXAI 字体统一：兼容版随包字体/许可清单由字体唯一配置生成（app-font-package.props，
       与主程序同一份 Assets/Fonts/app-font.json 同源）。换字体 = 改 app-font.json + 替换字体文件 +
       重跑 scripts/generate-app-font.py —— 本文件不再是第二个手改点（清单不随配置漂移）。 -->
  <Import Project="app-font-package.props" />
</Project>
