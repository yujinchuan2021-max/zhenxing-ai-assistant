<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- 【Q01】动态 Skip（真跳过而非伪造通过） -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TubaWinUi3.WinUI3\TubaWinUi3.csproj" />
    <ProjectReference Include="..\TubaWinUI3.BackEnd\TubaWinUi3.BackEnd.csproj" Aliases="backend" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit 运行配置：禁用集合并行，避免各测试类共享的全局静态
         （ToolCatalog.ToolsRoot / ConfigManager / AgentToolRegistry）跨集合竞争 -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI 工具文档：与主项目同源链接，保证测试环境 CliToolboxCatalog.Default 可读 -->
    <Content Include="..\CLI工具使用文档.md" Link="Metadata\CLI工具使用文档.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 项目轨道库：与主项目同源链接，保证 LearningTracksTool 测试可读 -->
    <Content Include="..\TubaWinUi3.WinUI3\Metadata\project-tracks.json" Link="Metadata\project-tracks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 【Q01】离线假 ACP 服务资产（DshAcpFakeServerTests 使用） -->
    <Content Include="TestAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TubaWinUi3.WinUI3\Assets\Skills\zhenxing-assistant\SKILL.md"
             Link="TestAssets\builtin-goal-skill\SKILL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
